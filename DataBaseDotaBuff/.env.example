# База данных приложения
DB_NAME=analytics_db
DB_ADMIN_USER=app_admin
DB_ADMIN_PASSWORD=change_me
DB_HOST=haproxy
DB_PORT=5000
POSTGRES_PORT=5000

# Роли аналитиков (через запятую), создаются сидером
ANALYST_NAMES=analyst1,analyst2

# Количество генерируемых записей
SEED_COUNT=1000

# Бэкапы
BACKUP_INTERVAL_CRON=*/5 * * * *
BACKUP_RETENTION_COUNT=5
